# Application Settings
APP_NAME=SIMORGH Platform API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simorgh_platform

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_PREFIX=sph_

# AI Providers (credentials managed by Platform, not applications)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
LOCAL_LLM_ENDPOINT=

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_REQUESTS_PER_HOUR=100

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
