# Application Settings
APP_NAME=SIMORGH Platform API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simorgh_platform

# Security
JWT_SECRET_KEY=replace-with-a-unique-32-character-minimum-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# AI Providers (credentials managed by Platform, not applications)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
LOCAL_LLM_ENDPOINT=

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=10000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS: comma-delimited origins; empty is safe by default
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=false
# Logical models are mapped by platform routing, never by caller credentials
LOGICAL_MODELS_CONFIG=
# Knowledge foundation
KNOWLEDGE_ENABLED=false
